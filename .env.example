# Copy to .env (never commit .env) and adjust.
PORT=3000
AUDIT_LOG_PATH=./data/audit-log.json
# 32 bytes as 64 hex chars:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUDIT_ENCRYPTION_KEY=
MOCK_AI_DELAY_MS=2000
BREAKER_FAILURE_THRESHOLD=3
BREAKER_RESET_MS=15000
ALLOW_FAILURE_SIMULATION=true
